# GEMINI_API_KEY: Required for server-side Gemini AI Trivia API calls (/api/trivia).
# Never expose this key in client-side VITE_* environment variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_ADMOB_REWARDED_AD_UNIT_ID: Optional production Google AdMob Rewarded Ad Unit ID.
# When omitted, official Google AdMob test Rewarded Ad Unit IDs are used automatically.
VITE_ADMOB_REWARDED_AD_UNIT_ID=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
